{
  "name": "@dsh-external/dsh-video-forge",
  "version": "0.1.0",
  "description": "Style-agnostic AI video pipeline for DeepSeek Harness: Seedream stills → ComfyUI post-processing → MiniMax H3 / Sand.ai MAGI-2 video → Three.js stage → Remotion frame-exact render.",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "comfyui-nodes",
    "fixtures"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "ai-video",
    "generative-video",
    "storyboard",
    "remotion",
    "three.js",
    "seedream",
    "minimax",
    "magi-2",
    "comfyui",
    "text-to-video",
    "image-to-video"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlnkx5200-beep/dsh-video-forge.git"
  },
  "homepage": "https://github.com/jlnkx5200-beep/dsh-video-forge#readme",
  "bugs": {
    "url": "https://github.com/jlnkx5200-beep/dsh-video-forge/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.0.1-0 <0.1.0-0 || >=0.1.0-0 <0.2.0-0 || >=0.2.0-0 <0.2.1-0 || >=0.2.1-0 <0.2.2-0 || >=0.2.2-0 <0.2.3-0 || >=0.2.3-0 <0.3.0-0 || >=0.3.0-0 <2",
    "@deepseek-ai/dsh-tools": ">=0.0.1-0 <0.1.0-0 || >=0.1.0-0 <0.2.0-0 || >=0.2.0-0 <0.2.1-0 || >=0.2.1-0 <0.2.2-0 || >=0.2.2-0 <0.2.3-0 || >=0.2.3-0 <0.3.0-0 || >=0.3.0-0 <2",
    "cordis": ">=4.0.0-0 <5",
    "schemastery": "^3.18.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.0.1-0 <0.1.0-0 || >=0.1.0-0 <0.2.0-0 || >=0.2.0-0 <0.2.1-0 || >=0.2.1-0 <0.2.2-0 || >=0.2.2-0 <0.2.3-0 || >=0.2.3-0 <0.3.0-0 || >=0.3.0-0 <2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-tools": "0.0.1-rc.1",
    "@types/node": "^24.13.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "schemastery": "3.18.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:client": "bash scripts/build-client.sh",
    "typecheck": "node scripts/link-deps.mjs && tsc -p tsconfig.json --noEmit",
    "check:plan": "node scripts/check-plan.mjs",
    "check:quality": "node scripts/check-quality.mjs",
    "check:frames": "node scripts/check-frames.mjs",
    "check:hygiene": "node scripts/check-hygiene.mjs",
    "pretest": "npm run build",
    "test": "node --test"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
